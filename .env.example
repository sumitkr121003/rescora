# Product scope only; this does not connect to NEAR or select a live network.
RESCORA_NETWORK=near-testnet

# Optional: authenticated, server-side FastNear NEAR Testnet RPC for live Burrow reads.
# Configure this only in the server environment (for example, Vercel project settings).
FASTNEAR_API_KEY=

# Optional: server-side Groq demo recommendation. Never use NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
